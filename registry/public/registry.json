{
  "$schema": "../../packages/registry-schema/src/registry.ts",
  "name": "aether-ui",
  "homepage": "https://aetherui.dev",
  "version": "0.0.1",
  "items": [
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "Status, category, or count label.",
      "author": "aetherstack",
      "dependencies": ["class-variance-authority", "@aetherstack/utils"],
      "files": [
        {
          "path": "packages/ui/src/components/badge.tsx",
          "type": "registry:ui",
          "target": "components/ui/badge.tsx"
        }
      ],
      "ai": {
        "intent": "Display a small inline label for status, category, or count",
        "prompts": [
          "add a status badge",
          "show a label pill",
          "display a count indicator",
          "add a tag chip",
          "show a category badge"
        ],
        "composition": ["button", "card", "table", "metric-card"],
        "slots": ["children"]
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A versatile button component with multiple variants and sizes.",
      "author": "aetherstack",
      "dependencies": ["class-variance-authority", "@radix-ui/react-slot", "@aetherstack/utils"],
      "files": [
        {
          "path": "packages/ui/src/components/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ],
      "ai": {
        "intent": "Trigger an action or navigate; supports multiple visual styles and sizes",
        "prompts": [
          "add a button",
          "create a submit button",
          "add a call to action",
          "add a destructive delete button",
          "add an icon button",
          "add a ghost button"
        ],
        "composition": ["form-field", "dialog", "card", "page-header", "empty-state"],
        "slots": ["children", "asChild"]
      }
    },
    {
