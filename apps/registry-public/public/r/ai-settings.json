  "files": [
    {
      "path": "packages/blocks/src/components/ai/ai-settings.tsx",
      "type": "registry:block",
      "target": "components/blocks/ai/ai-settings.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Eye, EyeOff } from \"lucide-react\"\nimport { cn } from \"@aetherstack/utils\"\nimport {\n  Card,\n  CardContent,\n  CardHeader,\n  CardTitle,\n  Input,\n  Label,\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n  Slider,\n  Textarea,\n  Separator,\n} from \"@aetherstack/ui\"\n\ninterface Model {\n  id: string\n  name: string\n  provider: string\n}\n\ninterface AISettingsProps {\n  apiKey?: string\n  onApiKeyChange?: (v: string) => void\n  model?: string\n  onModelChange?: (v: string) => void\n  models?: Model[]\n  temperature?: number\n  onTemperatureChange?: (v: number) => void\n  maxTokens?: number\n  onMaxTokensChange?: (v: number) => void\n  systemPrompt?: string\n  onSystemPromptChange?: (v: string) => void\n  className?: string\n}\n\nfunction AISettings({\n  apiKey = \"\",\n  onApiKeyChange,\n  model,\n  onModelChange,\n  models = [],\n  temperature = 0.7,\n  onTemperatureChange,\n  maxTokens = 2048,\n  onMaxTokensChange,\n  systemPrompt = \"\",\n  onSystemPromptChange,\n  className,\n}: AISettingsProps) {\n  const [showKey, setShowKey] = React.useState(false)\n\n  return (\n    <div className={cn(\"flex max-w-2xl flex-col gap-6\", className)}>\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"text-base\">API Configuration</CardTitle>\n        </CardHeader>\n        <CardContent className=\"flex flex-col gap-4\">\n          <div className=\"flex flex-col gap-2\">\n            <Label>API Key</Label>\n            <div className=\"relative\">\n              <Input\n                type={showKey ? \"text\" : \"password\"}\n                value={apiKey}\n                onChange={(e) => onApiKeyChange?.(e.target.value)}\n                placeholder=\"sk-…\"\n                className=\"pr-10\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => setShowKey((s) => !s)}\n                className=\"text-muted-foreground hover:text-foreground absolute right-3 top-1/2 -translate-y-1/2 transition-colors\"\n                aria-label={showKey ? \"Hide API key\" : \"Show API key\"}\n              >\n                {showKey ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n              </button>\n            </div>\n          </div>\n\n          {models.length > 0 && (\n            <div className=\"flex flex-col gap-2\">\n              <Label>Model</Label>\n              <Select\n                {...(model !== undefined ? { value: model } : {})}\n                {...(onModelChange !== undefined ? { onValueChange: onModelChange } : {})}\n              >\n                <SelectTrigger>\n                  <SelectValue placeholder=\"Select a model\" />\n                </SelectTrigger>\n                <SelectContent>\n                  {models.map((m) => (\n                    <SelectItem key={m.id} value={m.id}>\n                      {m.provider} / {m.name}\n                    </SelectItem>\n                  ))}\n                </SelectContent>\n              </Select>\n            </div>\n          )}\n        </CardContent>\n      </Card>\n\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"text-base\">Generation Parameters</CardTitle>\n        </CardHeader>\n        <CardContent className=\"flex flex-col gap-5\">\n          <div className=\"flex flex-col gap-2\">\n            <div className=\"flex items-center justify-between\">\n              <Label>Temperature</Label>\n              <span className=\"text-muted-foreground font-mono text-sm\">\n                {temperature.toFixed(2)}\n              </span>\n            </div>\n            <Slider\n              min={0}\n              max={2}\n              step={0.01}\n              value={[temperature]}\n              onValueChange={([v]) => v !== undefined && onTemperatureChange?.(v)}\n            />\n            <p className=\"text-muted-foreground text-xs\">\n              Controls randomness — 0 is deterministic, 2 is very creative.\n            </p>\n          </div>\n\n          <Separator />\n\n          <div className=\"flex flex-col gap-2\">\n            <div className=\"flex items-center justify-between\">\n              <Label>Max tokens</Label>\n              <span className=\"text-muted-foreground font-mono text-sm\">{maxTokens}</span>\n            </div>\n            <Slider\n              min={256}\n              max={8192}\n              step={256}\n              value={[maxTokens]}\n              onValueChange={([v]) => v !== undefined && onMaxTokensChange?.(v)}\n            />\n          </div>\n        </CardContent>\n      </Card>\n\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"text-base\">System Prompt</CardTitle>\n        </CardHeader>\n        <CardContent>\n          <Textarea\n            value={systemPrompt}\n            onChange={(e) => onSystemPromptChange?.(e.target.value)}\n            placeholder=\"You are a helpful assistant…\"\n            rows={6}\n            className=\"resize-y\"\n          />\n          <p className=\"text-muted-foreground mt-2 text-xs\">\n            This prompt is sent at the start of every conversation.\n          </p>\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n\nexport { AISettings }\n"
    }
  ],
  "ai": {
    "intent": "Use the Ai Settings component.",
    "prompts": [
      "add a ai settings"
    ],
    "composition": [],
    "slots": []
  }
}
