{
  "name": "@aetherstack/scripts",
  "version": "0.0.2",
  "private": true,
  "description": "Internal build scripts for the Aetherstack monorepo",
  "scripts": {
    "validate-registry": "tsx src/validate-registry.ts",
    "build-registry": "tsx src/build-registry.ts",
    "audit-inventory": "tsx src/audit-inventory.ts",
    "register-missing": "tsx src/register-missing-modules.ts",
    "consumer-install": "tsx src/consumer-install.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aetherstack/registry-build": "workspace:*",
    "@aetherstack/registry-schema": "workspace:*"
  },
  "devDependencies": {
    "@aetherstack/typescript-config": "workspace:*",
    "@types/node": "^20.12.7",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
